@model StudentChallanPageModel
@{
    ViewData["Title"] = "Challan";
    var challan = Model.Challan;
    var monthLabel = DateTime.Today.ToString("MMMM yyyy");
}

@if (challan is null)
{
    <div class="portal-card">
        <div class="d-flex align-items-start gap-3">
            <span class="metric-icon flex-shrink-0"><i class="bi bi-receipt"></i></span>
            <div>
                <h1 class="h4 fw-bold mb-2">No challan for @monthLabel</h1>
                <p class="text-muted mb-0">There is no fee challan issued for the current month yet.</p>
            </div>
        </div>
    </div>
}
else
{
    <div class="portal-card student-challan-record">
        <div class="challan-summary-head mb-3">
            <div class="challan-summary-title">
                <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Fee challan</span>
                <span class="challan-summary-no">@challan.ChallanNo</span>
                <span class="challan-summary-meta">
                    @challan.Semester · @challan.AcademicYear
                    · Issued @challan.IssueDate.ToString("dd MMM yyyy")
                    · Due @challan.DueDate.ToString("dd MMM yyyy")
                </span>
            </div>
            <div class="d-flex flex-column align-items-end gap-2 flex-shrink-0">
                <span class="badge rounded-pill text-bg-primary challan-summary-status">@challan.DisplayStatus</span>
                <a asp-action="PrintChallan" asp-route-id="@challan.Uid" target="_blank" class="btn btn-sm btn-primary">
                    <i class="bi bi-printer me-1"></i>Print challan
                </a>
            </div>
        </div>

        <dl class="row row-cols-1 row-cols-sm-2 g-2 mb-3 small">
            @if (!string.IsNullOrWhiteSpace(Model.StudentName))
            {
                <div class="col">
                    <dt class="text-muted mb-0">Student</dt>
                    <dd class="portal-grid-data mb-0">@Model.StudentName</dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.RegistrationNo))
            {
                <div class="col">
                    <dt class="text-muted mb-0">Registration</dt>
                    <dd class="portal-grid-data mb-0">@Model.RegistrationNo</dd>
                </div>
            }
        </dl>

        <div class="challan-summary-metrics mb-3">
            <div class="challan-summary-metric">
                <span class="challan-summary-label">Net payable</span>
                <span class="challan-summary-value">@challan.NetPayable.ToString("N2")</span>
            </div>
            <div class="challan-summary-metric">
                <span class="challan-summary-label">Paid</span>
                <span class="challan-summary-value">@challan.AmountPaid.ToString("N2")</span>
            </div>
            <div class="challan-summary-metric">
                <span class="challan-summary-label">Balance</span>
                <span class="challan-summary-value">@challan.Balance.ToString("N2")</span>
            </div>
        </div>

        @if (Model.Lines.Count == 0)
        {
            <p class="text-muted mb-0 small">No line items found for this challan.</p>
        }
        else
        {
            <div class="table-responsive border-top pt-3">
                <table class="table table-sm portal-data-grid align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Fee head</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end">Discount</th>
                            <th class="text-end">Late fine</th>
                            <th class="text-end">Net</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td class="portal-grid-data">@line.FeeHeadName</td>
                                <td class="portal-grid-data text-end">@line.Amount.ToString("N2")</td>
                                <td class="portal-grid-data text-end">@line.DiscountAmount.ToString("N2")</td>
                                <td class="portal-grid-data text-end">@line.LateFine.ToString("N2")</td>
                                <td class="portal-grid-data text-end fw-semibold">@line.NetAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
