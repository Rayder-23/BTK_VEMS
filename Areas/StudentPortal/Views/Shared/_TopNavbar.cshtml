@using VEMS.Areas.StudentPortal.Services
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var activeModuleKey = StudentPortalNavCatalog.ResolveModuleKey(currentController, currentAction);
}

<nav class="portal-module-nav" aria-label="Main modules">
    @foreach (var module in StudentPortalNavCatalog.TopBarModules)
    {
        var isActive = string.Equals(module.Key, activeModuleKey, StringComparison.OrdinalIgnoreCase);
        <a class="portal-module-link @(isActive ? "active" : "")"
           asp-area="StudentPortal"
           asp-controller="@module.DefaultController"
           asp-action="@module.DefaultAction"
           title="@module.Name">
            <i class="bi @module.IconClass"></i>
            <span>@module.Name</span>
        </a>
    }
</nav>
