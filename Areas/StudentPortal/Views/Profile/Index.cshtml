@model StudentProfilePageViewModel
@{
    ViewData["Title"] = "My Profile";
    var profile = Model.Profile;
}

<section class="module-page-header accent-blue mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="module-page-icon"><i class="bi bi-person-circle"></i></span>
        <div>
            <h1 class="h3 fw-bold mb-1">@profile.FullName</h1>
            <p class="text-muted mb-0">
                @profile.RegistrationNo
                @if (profile.RollNo.HasValue)
                {
                    <span> · Roll @profile.RollNo</span>
                }
            </p>
        </div>
    </div>
</section>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="portal-card h-100">
            <h2 class="h5 fw-bold mb-3">Student information</h2>
            <dl class="row mb-0 profile-dl">
                <dt class="col-sm-4">Registration</dt>
                <dd class="col-sm-8">@profile.RegistrationNo</dd>
                <dt class="col-sm-4">Mobile</dt>
                <dd class="col-sm-8">@(profile.MobileNo ?? "—")</dd>
                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@(profile.Email ?? "—")</dd>
                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@(profile.IsActive ? "Active" : "Inactive")</dd>
                <dt class="col-sm-4">Created on</dt>
                <dd class="col-sm-8">@profile.CreatedOn.ToString("dd MMM yyyy")</dd>
            </dl>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="portal-card h-100">
            <h2 class="h5 fw-bold mb-3">Enrollment information</h2>
            <dl class="row mb-0 profile-dl">
                <dt class="col-sm-4">Program</dt>
                <dd class="col-sm-8">@(profile.ProgramName ?? "—")</dd>
                <dt class="col-sm-4">Program code</dt>
                <dd class="col-sm-8">@(profile.ProgramCode ?? "—")</dd>
                <dt class="col-sm-4">Academic year</dt>
                <dd class="col-sm-8">@(profile.AcademicYearName ?? "—")</dd>
                <dt class="col-sm-4">Class section</dt>
                <dd class="col-sm-8">@(profile.ClassSectionDisplay ?? "—")</dd>
                <dt class="col-sm-4">Roll number</dt>
                <dd class="col-sm-8">@(profile.RollNo?.ToString() ?? "—")</dd>
                <dt class="col-sm-4">Enrollment date</dt>
                <dd class="col-sm-8">@(profile.EnrollmentDate?.ToString("dd MMM yyyy") ?? "—")</dd>
            </dl>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="portal-card h-100">
            <h2 class="h5 fw-bold mb-3">Portal account</h2>
            <dl class="row mb-0 profile-dl">
                <dt class="col-sm-4">Username</dt>
                <dd class="col-sm-8">@(profile.PortalUsername ?? "—")</dd>
                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@(profile.PortalEmail ?? "—")</dd>
                <dt class="col-sm-4">Login status</dt>
                <dd class="col-sm-8">@(profile.PortalStatus ?? "—")</dd>
                <dt class="col-sm-4">Last login</dt>
                <dd class="col-sm-8">@(profile.LastLoginAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd>
            </dl>
        </div>
    </div>
</div>
