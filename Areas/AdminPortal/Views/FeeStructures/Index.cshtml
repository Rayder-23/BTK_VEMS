@using VEMS.Areas.AdminPortal.Models.Fee
@model IReadOnlyList<VEMS.Areas.AdminPortal.Models.Fee.FeeStructureListItem>
@{
    ViewData["Title"] = "Fee Structures";
    var selectedProgramId = ViewData["ProgramId"] as int?;
    var programs = ViewData["Programs"] as IReadOnlyList<FeeLookupItem> ?? Array.Empty<FeeLookupItem>();
}

<section class="portal-card page-summary-compact mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/adminportal/fee">Fee</a></li>
            <li class="breadcrumb-item active">Fee Structures</li>
        </ol>
    </nav>
    <div class="page-summary-head">
        <span class="page-summary-title">Fee Structures</span>
        <a class="btn btn-sm btn-primary rounded-pill flex-shrink-0" href="/adminportal/fee/fee-structures/create">Add structure</a>
    </div>
</section>

<partial name="_FeeAlerts" />

<section class="portal-card mt-3">
    <form method="get" class="row g-2 mb-3 align-items-end">
        <div class="col-md-6">
            <label class="form-label" for="feeStructureProgramFilter">Program</label>
            <select id="feeStructureProgramFilter" name="programId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All programs</option>
                @foreach (var program in programs)
                {
                    if (selectedProgramId.HasValue && selectedProgramId.Value == program.Id)
                    {
                        <option value="@program.Id" selected="selected">@program.Name</option>
                    }
                    else
                    {
                        <option value="@program.Id">@program.Name</option>
                    }
                }
            </select>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-sm admin-table admin-table-compact align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Program</th>
                    <th>Class</th>
                    <th>Semester</th>
                    <th>Year</th>
                    <th>Lines</th>
                    <th>Total</th>
                    <th>Active</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">
                        @(selectedProgramId.HasValue
                            ? "No fee structures found for the selected program."
                            : "No fee structures found.")
                    </td>
                </tr>
            }
            else
            {
                @foreach (var row in Model)
                {
                    <tr>
                        <td>@row.StructureName</td>
                        <td>@row.ProgramName</td>
                        <td>@(string.IsNullOrWhiteSpace(row.ClassName) ? "—" : row.ClassName)</td>
                        <td>@row.Semester</td>
                        <td>@row.AcademicYear</td>
                        <td>@row.DetailCount</td>
                        <td>@row.TotalAmount.ToString("N2")</td>
                        <td>@(row.IsActive ? "Yes" : "No")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="/adminportal/fee/fee-structures/details/@row.Uid">Add Fee Heads</a>
                            <a class="btn btn-sm btn-outline-secondary" href="/adminportal/fee/fee-structures/edit/@row.Uid">Edit</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
