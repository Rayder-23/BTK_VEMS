@model VEMS.Areas.AdminPortal.Models.Fee.FeeStructureFormModel
@using VEMS.Areas.AdminPortal.Models.Fee
@{
    var programs = ViewData["Programs"] as IReadOnlyList<FeeLookupItem> ?? Array.Empty<FeeLookupItem>();
    var academicYears = ViewData["AcademicYears"] as IReadOnlyList<FeeLookupItem> ?? Array.Empty<FeeLookupItem>();
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="fee-structure-form-grid">
    <div class="row fee-structure-form-row align-items-center">
        <label asp-for="StructureName" class="col-12 col-sm-4 col-lg-2 fee-structure-form-label"></label>
        <div class="col-12 col-sm-8 col-lg-4 fee-structure-form-field">
            <input asp-for="StructureName" class="form-control form-control-sm" />
            <span asp-validation-for="StructureName" class="text-danger small"></span>
        </div>
        <label asp-for="ProgramId" class="col-12 col-sm-4 col-lg-2 fee-structure-form-label fee-structure-form-label--pair-start"></label>
        <div class="col-12 col-sm-8 col-lg-4 fee-structure-form-field">
            <select asp-for="ProgramId" id="feeStructureProgramId" class="form-select form-select-sm" asp-items="@(new SelectList(programs, "Id", "Name"))">
                <option value="">— Select program —</option>
            </select>
            <span asp-validation-for="ProgramId" class="text-danger small"></span>
        </div>
    </div>

    <div class="row fee-structure-form-row align-items-center">
        <label asp-for="ClassId" class="col-12 col-sm-4 col-lg-2 fee-structure-form-label"></label>
        <div class="col-12 col-sm-8 col-lg-4 fee-structure-form-field">
            <select asp-for="ClassId" id="feeStructureClassId" class="form-select form-select-sm" data-initial-class-id="@(Model.ClassId?.ToString() ?? "")">
                <option value="">— All classes —</option>
            </select>
            <span asp-validation-for="ClassId" class="text-danger small"></span>
            <div class="form-text">Choose a class when fee amounts differ by section.</div>
        </div>
        <label asp-for="Semester" class="col-12 col-sm-4 col-lg-2 fee-structure-form-label fee-structure-form-label--pair-start"></label>
        <div class="col-12 col-sm-8 col-lg-4 fee-structure-form-field">
            <select asp-for="Semester" id="feeStructureSemester" class="form-select form-select-sm" asp-items="@(new SelectList(FeeConstants.Semesters))"></select>
            <span asp-validation-for="Semester" class="text-danger small"></span>
        </div>
    </div>

    <div class="row fee-structure-form-row align-items-center">
        <label asp-for="AcademicYear" class="col-12 col-sm-4 col-lg-2 fee-structure-form-label"></label>
        <div class="col-12 col-sm-8 col-lg-4 fee-structure-form-field">
            <select asp-for="AcademicYear" id="feeStructureAcademicYear" class="form-select form-select-sm"
                    asp-items="@(new SelectList(academicYears, nameof(FeeLookupItem.Id), nameof(FeeLookupItem.Name)))">
                @if (academicYears.Count == 0)
                {
                    <option value="">— No academic years configured —</option>
                }
            </select>
            <span asp-validation-for="AcademicYear" class="text-danger small"></span>
        </div>
        <label asp-for="IsActive" class="col-12 col-sm-4 col-lg-2 fee-structure-form-label fee-structure-form-label--pair-start"></label>
        <div class="col-12 col-sm-8 col-lg-4 fee-structure-form-field">
            <div class="form-check mb-0">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>
</div>
