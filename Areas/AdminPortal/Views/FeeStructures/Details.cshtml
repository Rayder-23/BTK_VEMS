@model VEMS.Areas.AdminPortal.Models.Fee.FeeStructureDetailsPageModel
@using VEMS.Areas.AdminPortal.Models.Fee
@{
    ViewData["Title"] = "Structure Details";
    var feeHeads = ViewData["FeeHeads"] as IReadOnlyList<FeeLookupItem> ?? Model.FeeHeads;
    var s = Model.Structure;
    var structureMeta = s.ProgramName
        + (string.IsNullOrWhiteSpace(s.ClassName) ? "" : $" · {s.ClassName}")
        + $" · {s.Semester} · {s.AcademicYear}";
    var summaryTitle = $"{s.StructureName} - {structureMeta}";
}

<section class="portal-card page-summary-compact mb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/adminportal/fee/fee-structures">Structures</a></li>
            <li class="breadcrumb-item active">@s.StructureName</li>
        </ol>
    </nav>
    <div class="page-summary-head">
        <span class="page-summary-title">@summaryTitle</span>
        <a class="btn btn-sm btn-outline-secondary rounded-pill flex-shrink-0" href="/adminportal/fee/fee-structures/edit/@s.Uid">Edit</a>
    </div>
</section>

<partial name="_FeeAlerts" />

<section class="portal-card mt-3">
    <h2 class="h6 fw-bold mb-2">Line items</h2>
    <div class="table-responsive">
        <table class="table table-sm portal-data-grid fee-structure-details-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Fee head</th>
                    <th>Amount</th>
                    <th>Frequency</th>
                    <th>Period</th>
                    <th>Due date</th>
                    <th>Late fine/day</th>
                    <th>Max late fine</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Lines.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-3">No fee heads added yet.</td>
                </tr>
            }
            else
            {
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td class="portal-grid-data fee-structure-grid-data">@line.FeeHeadName</td>
                        <td class="portal-grid-data fee-structure-grid-data text-end">@line.Amount.ToString("N2")</td>
                        <td class="portal-grid-data fee-structure-grid-data">@line.Frequency</td>
                        <td class="portal-grid-data fee-structure-grid-data">
                            @(line.Frequency == "OneTime" && line.ApplicableMonth.HasValue && line.ApplicableYear.HasValue
                                ? $"{line.ApplicableMonth:00}/{line.ApplicableYear}"
                                : "—")
                        </td>
                        <td class="portal-grid-data fee-structure-grid-data">@(line.DueDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td class="portal-grid-data fee-structure-grid-data text-end">@line.LateFinePerDay.ToString("N2")</td>
                        <td class="portal-grid-data fee-structure-grid-data text-end">@line.MaxLateFine.ToString("N2")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary"
                               href="/adminportal/fee/fee-structures/details/@s.Uid/edit-line/@line.Uid">Edit</a>
                            <form method="post" action="/adminportal/fee/fee-structures/details/@s.Uid/delete-line/@line.Uid"
                                  onsubmit="return confirm('Remove this line?');" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>

<section class="portal-card mt-3">
    <h2 class="h6 fw-bold mb-3">Add fee head</h2>
    <form method="post" action="/adminportal/fee/fee-structures/details/@s.Uid/add-line" id="feeStructureDetailAddForm">
        @Html.AntiForgeryToken()
        @{
            ViewData["FeeHeads"] = feeHeads;
            ViewData["DefaultApplicableYear"] = s.AcademicYear;
        }
        <partial name="_FeeStructureDetailLineForm" model="Model.NewLine" />
    </form>
    <div class="mt-3">
        <button type="submit" form="feeStructureDetailAddForm" class="btn btn-sm btn-primary">Add line</button>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_FeeStructureDetailLineScripts" />
}
