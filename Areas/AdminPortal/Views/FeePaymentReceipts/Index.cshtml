@model IReadOnlyList<VEMS.Areas.AdminPortal.Models.Fee.PaymentListItem>
@{ ViewData["Title"] = "Receipts"; }

<section class="portal-card page-summary-compact mb-3">
    <div class="page-summary-head">
        <span class="page-summary-title">Payment receipts</span>
    </div>
</section>

<partial name="_FeeAlerts" />

<section class="portal-card mt-3">
    <div class="table-responsive">
        <table class="table table-sm portal-data-grid align-middle mb-0">
            <thead>
                <tr>
                    <th>Receipt</th>
                    <th>Date</th>
                    <th>Challan</th>
                    <th>Student</th>
                    <th>Amount</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-3">No receipts found.</td>
                </tr>
            }
            else
            {
                @foreach (var row in Model)
                {
                    <tr>
                        <td class="portal-grid-data">@(row.ReceiptNo ?? "—")</td>
                        <td class="portal-grid-data">@row.PaymentDate.ToString("yyyy-MM-dd")</td>
                        <td class="portal-grid-data">@row.ChallanNo</td>
                        <td class="portal-grid-data">@row.StudentName</td>
                        <td class="portal-grid-data">@row.AmountPaid.ToString("N2")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="/adminportal/fee/payment-receipts/print/@row.Uid" target="_blank">Print</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
