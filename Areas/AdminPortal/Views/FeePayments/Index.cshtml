@model IReadOnlyList<VEMS.Areas.AdminPortal.Models.Fee.PaymentListItem>
@{ ViewData["Title"] = "Payments"; }

<section class="portal-card page-summary-compact mb-3">
    <div class="page-summary-head">
        <span class="page-summary-title">Payments</span>
        <a class="btn btn-sm btn-primary rounded-pill flex-shrink-0" href="/adminportal/fee/payments/create">Record payment</a>
    </div>
</section>

<partial name="_FeeAlerts" />

<section class="portal-card mt-3">
    <div class="table-responsive">
        <table class="table table-sm portal-data-grid align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Challan</th>
                    <th>Student</th>
                    <th>Amount</th>
                    <th>Mode</th>
                    <th>Receipt</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-3">No payments recorded yet.</td>
                </tr>
            }
            else
            {
                @foreach (var row in Model)
                {
                    <tr>
                        <td class="portal-grid-data">@row.PaymentDate.ToString("yyyy-MM-dd")</td>
                        <td class="portal-grid-data">@row.ChallanNo</td>
                        <td class="portal-grid-data">@row.StudentName</td>
                        <td class="portal-grid-data">@row.AmountPaid.ToString("N2")</td>
                        <td class="portal-grid-data">@row.PaymentMode</td>
                        <td class="portal-grid-data">
                            @if (!string.IsNullOrEmpty(row.ReceiptNo))
                            {
                                <a href="/adminportal/fee/payment-receipts/print/@row.Uid">@row.ReceiptNo</a>
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
