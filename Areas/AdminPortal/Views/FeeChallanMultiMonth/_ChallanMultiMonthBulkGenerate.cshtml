@using VEMS.Areas.AdminPortal.Models.Fee
@{
    var programs = ViewData["Programs"] as IReadOnlyList<FeeLookupItem> ?? Array.Empty<FeeLookupItem>();
    var currentMonth = DateTime.Today.ToString("yyyy-MM");
}

<section id="challanMultiMonthGenerate" class="portal-card mb-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="h6 fw-bold mb-1">Generate multi-month challans</h2>
            <p class="text-muted small mb-0">Select program, billing range, and students. One challan is created per student with combined fees for all months in the range.</p>
        </div>
        <a class="btn btn-sm btn-outline-secondary rounded-pill" href="/adminportal/fee/challans">Single-month challans</a>
    </div>

    <div class="row g-2 align-items-end mb-3">
        <div class="col-md-4">
            <label class="form-label" for="mmBulkProgramId">Program</label>
            <select id="mmBulkProgramId" class="form-select form-select-sm">
                <option value="">— Select program —</option>
                @foreach (var program in programs)
                {
                    <option value="@program.Id">@program.Name</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="mmBulkStructureId">Fee structure</label>
            <select id="mmBulkStructureId" class="form-select form-select-sm" disabled>
                <option value="">— Select program first —</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="mmBulkFromMonth">From</label>
            <input id="mmBulkFromMonth" class="form-control form-control-sm" type="month" value="@currentMonth" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="mmBulkToMonth">To</label>
            <input id="mmBulkToMonth" class="form-control form-control-sm" type="month" value="@currentMonth" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="mmBulkIssueDate">Issue date</label>
            <input id="mmBulkIssueDate" class="form-control form-control-sm" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="mmBulkDueDate">Due date</label>
            <input id="mmBulkDueDate" class="form-control form-control-sm" type="date" value="@DateTime.Today.AddDays(15).ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-4">
            <button type="button" id="mmBulkLoadStudentsBtn" class="btn btn-sm btn-outline-primary w-100">Search</button>
        </div>
        <div class="col-md-4">
            <button type="button" id="mmBulkGenerateSelectedBtn" class="btn btn-sm btn-primary w-100" disabled>
                Create challans (<span id="mmBulkSelectedCount">0</span>)
            </button>
        </div>
        <div class="col-12">
            <span id="mmBulkFilterError" class="text-danger small d-none"></span>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <span id="mmBulkSelectionCount" class="small text-muted">Select a program and billing range, then search.</span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm admin-table admin-table-compact align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 2.5rem;">
                        <input type="checkbox" id="mmBulkSelectAll" class="form-check-input" aria-label="Select all students" disabled />
                    </th>
                    <th>#</th>
                    <th>Reg no.</th>
                    <th>Roll no.</th>
                    <th>Student</th>
                    <th>Program</th>
                    <th>Concession</th>
                    <th>Challan in range</th>
                </tr>
            </thead>
            <tbody id="mmBulkStudentTableBody">
                <tr id="mmBulkStudentPlaceholder">
                    <td colspan="8" class="text-center text-muted py-4">Select a program, billing range, and click Search to load students.</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<section id="mmBulkResultSection" class="portal-card mb-3 d-none">
    <h2 class="h6 fw-bold mb-3">Generation summary</h2>
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3">
            <div class="small text-muted">Processed</div>
            <div class="h5 fw-bold mb-0" id="mmBulkTotalProcessed">0</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="small text-muted">Generated</div>
            <div class="h5 fw-bold mb-0 text-success" id="mmBulkTotalGenerated">0</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="small text-muted">Skipped</div>
            <div class="h5 fw-bold mb-0 text-warning" id="mmBulkTotalSkipped">0</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="small text-muted">Errors</div>
            <div class="h5 fw-bold mb-0 text-danger" id="mmBulkTotalErrors">0</div>
        </div>
    </div>
    <div id="mmBulkResultMessage" class="alert alert-success py-2 d-none" role="status"></div>
    <div class="table-responsive">
        <table class="table table-sm admin-table admin-table-compact align-middle mb-0">
            <thead>
                <tr>
                    <th>Reg no.</th>
                    <th>Student</th>
                    <th>Challan no.</th>
                    <th>Net</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="mmBulkResultTableBody"></tbody>
        </table>
    </div>
</section>

<script src="~/js/fee/bulk-challans-multimonth.js" asp-append-version="true"></script>
