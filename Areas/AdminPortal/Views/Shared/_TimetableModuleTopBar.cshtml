@using VEMS.Areas.AdminPortal.Services
@{
    var path = Context.Request.Path.Value ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var activeKey = TimetableNavCatalog.ResolveActiveKey(path, action);
    var isDashboardActive = string.Equals(activeKey, "dashboard", StringComparison.OrdinalIgnoreCase);
}
<header class="fee-erp-module-topbar timetable-mgmt-module-topbar portal-navbar-primary" aria-label="Timetable module">
    <div class="container-fluid h-100 px-3 px-lg-4 d-flex align-items-center gap-2 gap-lg-3">
        <button class="btn btn-outline-light btn-sm d-lg-none flex-shrink-0 timetable-mgmt-menu-btn portal-menu-btn" type="button"
                data-bs-toggle="offcanvas" data-bs-target="#feeErpSidebarOffcanvas"
                aria-controls="feeErpSidebarOffcanvas" aria-label="Open navigation menu">
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>

        <a href="/adminportal/timetable"
           class="timetable-mgmt-module-topbar__brand portal-module-link @(isDashboardActive ? "active" : "") text-decoration-none d-inline-flex align-items-center gap-2 flex-shrink-0"
           aria-label="Timetable home"
           title="Class timetable">
            <span class="timetable-mgmt-module-topbar__logo rounded-2 d-inline-flex align-items-center justify-content-center">
                <i class="fa-solid fa-calendar-week" aria-hidden="true"></i>
            </span>
            <span class="timetable-mgmt-module-topbar__title fw-semibold">Timetable</span>
        </a>

        <nav class="timetable-mgmt-module-nav portal-module-nav flex-grow-1" aria-label="Timetable module navigation">
            @foreach (var item in TimetableNavCatalog.SidebarNav)
            {
                if (string.Equals(item.Key, "dashboard", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                var isActive = string.Equals(item.Key, activeKey, StringComparison.OrdinalIgnoreCase);
                <a class="portal-module-link @(isActive ? "active" : "")" href="@item.Url" title="@item.Name">
                    <i class="fa-solid @item.IconClass" aria-hidden="true"></i>
                    <span>@item.Name</span>
                </a>
            }
        </nav>

        <a class="timetable-mgmt-module-topbar__link small text-decoration-none flex-shrink-0" href="/adminportal">
            <i class="fa-solid fa-house-chimney me-1" aria-hidden="true"></i>Admin portal
        </a>
    </div>
</header>
