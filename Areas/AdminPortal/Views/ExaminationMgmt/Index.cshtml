@model IReadOnlyList<VEMS.Areas.AdminPortal.Models.Examination.ExaminationDashboardTile>
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Examination · Dashboard";
}

<section class="portal-card page-summary-compact em-dashboard-summary mb-2" aria-label="Dashboard overview">
    <div class="page-summary-head">
        <div class="page-summary-title-block">
            <div class="page-summary-title">Dashboard</div>
            <div class="page-summary-meta">Exam setup, marking, schedules, student marks, submissions, grades, and semester results.</div>
        </div>
    </div>
</section>

<section class="portal-card em-dashboard-modules" aria-label="Examination modules">
    <h2 class="em-dashboard-modules__heading">Modules</h2>
    <div class="row g-2 em-module-grid">
        @foreach (var tile in Model)
        {
            <div class="col-12 col-sm-6 col-xl-3">
                <a class="em-module-card @tile.AccentClass" href="@tile.Url">
                    <span class="em-module-card__icon @tile.AccentClass" aria-hidden="true">
                        <i class="bi @tile.IconClass"></i>
                    </span>
                    <span class="em-module-card__body">
                        <span class="em-module-card__title">
                            <span class="em-module-card__seq">@tile.Sequence.</span> @tile.Title
                        </span>
                        <span class="em-module-card__desc">@tile.Description</span>
                    </span>
                </a>
            </div>
        }
    </div>
</section>
